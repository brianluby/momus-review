# The TypeSafe API key. Required for the hosted API; optional when
# TYPESAFE_BASE_URL points at a local server. Copy to .env or export in your shell.
TYPESAFE_API_KEY=

# Optional: a local System One server (e.g. Winnow-12B) instead of hosted Jev.
# Winnow accepts the default jev-latest as an alias; its advertised id is
# Winnow-12B. Other servers may need an explicit TYPESAFE_DEFAULT_MODEL.
# TYPESAFE_BASE_URL=http://127.0.0.1:8091
# TYPESAFE_DEFAULT_MODEL=Winnow-12B
# TYPESAFE_TIMEOUT_SECS=300
# MOMUS_CONCURRENCY=1

# Secret redaction before sending code to the API is on by default.
# MOMUS_REDACT=off
